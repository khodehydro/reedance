{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reedance:draft:v1",
  "title": "Reedance content-only authoring draft v1",
  "description": "A SINGLE UTF-8 .rddraft.json generated from lyrics by the content agent. It contains educational content, but NO audio, media path or lyric timing. Windows selects the audio, aligns every line, reviews and builds the published lesson. Register urn:reedance:lesson:v1 from lesson.schema.json to resolve the shared definitions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["draftSchemaVersion", "songId", "targetLanguage", "locale", "title", "createdAt", "generator", "sources", "lyrics", "vocabulary", "grammar", "idioms", "sentences", "vocabularyTables", "questions"],
  "properties": {
    "draftSchemaVersion": { "const": 1 },
    "songId": { "$ref": "urn:reedance:lesson:v1#/$defs/id" },
    "targetLanguage": { "$ref": "urn:reedance:lesson:v1#/$defs/language" },
    "locale": { "$ref": "urn:reedance:lesson:v1#/$defs/locale" },
    "title": { "$ref": "urn:reedance:lesson:v1#/$defs/text" },
    "artist": { "$ref": "urn:reedance:lesson:v1#/$defs/text" },
    "level": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "generator": { "type": "string", "minLength": 1, "maxLength": 256 },
    "notes": { "type": "string", "maxLength": 5000 },
    "sources": {
      "type": "object", "additionalProperties": false, "required": ["lyrics", "lesson"],
      "properties": {
        "lyrics": { "$ref": "#/$defs/source" },
        "lesson": { "$ref": "#/$defs/source" }
      }
    },
    "credits": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "lyrics": { "$ref": "urn:reedance:lesson:v1#/$defs/shortText" },
        "noticeFa": { "$ref": "urn:reedance:lesson:v1#/$defs/text" },
        "noticeEn": { "$ref": "urn:reedance:lesson:v1#/$defs/text" }
      }
    },
    "disclaimerFa": { "$ref": "urn:reedance:lesson:v1#/$defs/text" },
    "disclaimerEn": { "$ref": "urn:reedance:lesson:v1#/$defs/text" },
    "lyrics": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "urn:reedance:lesson:v1#/$defs/untimedLine" } },
    "vocabulary": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "urn:reedance:lesson:v1#/$defs/word" } },
    "grammar": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "urn:reedance:lesson:v1#/$defs/grammarItem" } },
    "idioms": { "type": "array", "maxItems": 200, "items": { "$ref": "urn:reedance:lesson:v1#/$defs/phrase" } },
    "sentences": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "urn:reedance:lesson:v1#/$defs/phrase" } },
    "vocabularyTables": { "type": "array", "maxItems": 20, "items": { "$ref": "urn:reedance:lesson:v1#/$defs/table" } },
    "questions": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "urn:reedance:lesson:v1#/$defs/question" } },
    "idAliases": { "type": "array", "maxItems": 1000, "items": { "$ref": "urn:reedance:lesson:v1#/$defs/idAlias" } }
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["description", "rightsStatus"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "rightsStatus": { "enum": ["unverified", "documented"] },
        "sourceReference": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "permissionRef": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "attribution": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
